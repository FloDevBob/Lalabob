// Copiez ce fichier en Config/Local.xcconfig (non versionné).
// Par défaut, Lalabob est signé localement, sans compte Apple : rien à remplir ici.
//
// Plus tard, pour signer avec un identifiant Apple (gratuit « Personal Team » ou payant),
// décommentez ces trois lignes et indiquez votre identifiant d'équipe (`make team`) :
// LALABOB_SIGN_STYLE = Automatic
// LALABOB_SIGN_IDENTITY = Apple Development
// LALABOB_TEAM = XXXXXXXXXX
